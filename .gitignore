# ─────────────────────────────────────────────
# Shopify Theme Development — .gitignore
# ─────────────────────────────────────────────

# Kiro IDE — steering/rules files (local dev context only)
.kiro/

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Node (if using Shopify CLI or build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Shopify CLI
.shopify/
shopify.app.toml

# Environment / secrets
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Logs
*.log

# Markdown docs (local notes, not part of theme)
*.md
