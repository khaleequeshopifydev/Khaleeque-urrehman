{% comment %}
  tv-banner.liquid
  ─────────────────────────────────────────────────────────────
  Tisso Vison — Banner Section
  Parts:
    1. Topbar   — logo | announcement | CTA button  ✓
    2. Hero     — coming next
    3. Marquee  — coming next
  ─────────────────────────────────────────────────────────────
{% endcomment %}

{% render 'tv-fonts' %}

{%- liquid
  assign logo_img     = section.settings.logo_image
  assign announcement = section.settings.announcement_text
  assign cta_label    = section.settings.cta_label
  assign cta_link     = section.settings.cta_link
  assign heading      = section.settings.heading
  assign description  = section.settings.description
  assign btn_label    = section.settings.btn_label
  assign btn_link     = section.settings.btn_link
  assign illustration = section.settings.illustration
  assign marquee_text = section.settings.marquee_text
-%}

<div class="tv-banner" data-section-id="{{ section.id }}">

  {%- comment -%} ── 1. TOPBAR ─────────────────────────────── {%- endcomment -%}
  <div class="tv-banner__topbar">

    {%- comment -%} Left: Logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="tv-banner__logo-link" aria-label="{{ shop.name }}">
      {%- if logo_img != blank -%}
        <img
          src="{{ logo_img | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          class="tv-banner__logo"
          width="152"
          height="19"
          loading="eager"
        >
      {%- else -%}
        <img
          src="{{ 'tisso-vison-logo.svg' | asset_url }}"
          alt="{{ shop.name }}"
          class="tv-banner__logo"
          width="152"
          height="19"
          loading="eager"
        >
      {%- endif -%}
    </a>

    {%- comment -%} Center: Announcement text {%- endcomment -%}
    {%- if announcement != blank -%}
      <p class="tv-banner__announcement">{{ announcement }}</p>
    {%- endif -%}

    {%- comment -%} Right: CTA button {%- endcomment -%}
    {%- if cta_label != blank -%}
      <a
        href="{{ cta_link | default: '#' }}"
        class="tv-btn tv-btn--yellow tv-banner__cta"
      >
        <span class="tv-btn__text">{{ cta_label }}</span>
        <span class="tv-btn__arrow" aria-hidden="true">
          <img
            src="{{ 'tv-icon-arrow.svg' | asset_url }}"
            alt=""
            width="26"
            height="12"
            class="tv-btn__arrow-icon tv-btn__arrow-icon--dark"
          >
        </span>
      </a>
    {%- endif -%}

  </div>
  {%- comment -%} ── END TOPBAR ───────────────────────────────── {%- endcomment -%}


  {%- comment -%} ── 2. HERO ──────────────────────────────────── {%- endcomment -%}
  <div class="tv-banner__hero">

    {%- comment -%} Background illustration — full bleed {%- endcomment -%}
    {%- if illustration != blank -%}
      <img
        src="{{ illustration | image_url: width: 1440 }}"
        srcset="
          {{ illustration | image_url: width: 750 }} 750w,
          {{ illustration | image_url: width: 1100 }} 1100w,
          {{ illustration | image_url: width: 1440 }} 1440w
        "
        sizes="100vw"
        alt=""
        class="tv-banner__illustration"
        width="{{ illustration.width }}"
        height="{{ illustration.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <img
        src="{{ 'tv-banner-illustration.png' | asset_url }}"
        alt=""
        class="tv-banner__illustration"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}

    {%- comment -%} Content box — heading + description {%- endcomment -%}
    <div class="tv-banner__content">
      {%- if heading != blank -%}
        <h1 class="tv-banner__heading">{{ heading }}</h1>
      {%- endif -%}

      {%- if description != blank -%}
        <p class="tv-banner__description">{{ description }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Button — separate from content for mobile flex ordering {%- endcomment -%}
    {%- if btn_label != blank -%}
      <div class="tv-banner__btn-wrapper">
        <a
          href="{{ btn_link | default: '#' }}"
          class="tv-btn tv-btn--dark tv-banner__btn"
        >
          <span class="tv-btn__text">{{ btn_label }}</span>
          <span class="tv-btn__arrow" aria-hidden="true">
            <img
              src="{{ 'tv-icon-arrow.svg' | asset_url }}"
              alt=""
              width="26"
              height="12"
              class="tv-btn__arrow-icon tv-btn__arrow-icon--light"
            >
          </span>
        </a>
      </div>
    {%- endif -%}

  </div>
  {%- comment -%} ── END HERO ─────────────────────────────────── {%- endcomment -%}


  {%- comment -%} ── 3. MARQUEE ───────────────────────────────── {%- endcomment -%}
  {%- if marquee_text != blank -%}
    <div class="tv-banner__marquee" aria-label="{{ marquee_text }}">
      <div class="tv-marquee__track">
        {%- comment -%} Text repeated 4× for seamless infinite scroll {%- endcomment -%}
        <span class="tv-marquee__text">{{ marquee_text }}</span>
        <span class="tv-marquee__text">{{ marquee_text }}</span>
        <span class="tv-marquee__text">{{ marquee_text }}</span>
        <span class="tv-marquee__text">{{ marquee_text }}</span>
      </div>
    </div>
  {%- endif -%}
  {%- comment -%} ── END MARQUEE ──────────────────────────────── {%- endcomment -%}

</div>

{% stylesheet %}
/* ─────────────────────────────────────────────────────────────
   TV BANNER — Design tokens (CSS custom properties)
   All values derived from Figma specs.
   Scoped to .tv-banner to avoid collision with Horizon styles.
   ───────────────────────────────────────────────────────────── */
.tv-banner {
  /* Typography */
  --tv-font-primary:   'Jost', sans-serif;
  --tv-font-secondary: 'Lustria', serif; /* marquee only */

  /* Topbar — from Figma */
  --tv-topbar-bg:        #F5F5F5;
  --tv-topbar-height:    4rem;         /* 64px */
  --tv-topbar-pad-y:     0.625rem;     /* 10px */
  --tv-topbar-pad-x:     3.125rem;     /* 50px */

  /* Hero — from Figma */
  --tv-hero-bg:             #FFFFFF;
  --tv-hero-heading-size:   4.375rem;  /* 70px desktop */
  --tv-hero-heading-weight: 500;
  --tv-hero-heading-lh:     1;
  --tv-hero-heading-color:  #000000;
  --tv-hero-desc-size:      1.25rem;   /* 20px desktop */
  --tv-hero-desc-weight:    400;
  --tv-hero-desc-lh:        1.4;
  --tv-hero-desc-color:     #000000;
  --tv-hero-content-max:    40%;       /* max-width for content wrapping */
  --tv-hero-pad-left:       3.125rem;  /* 50px left padding */
  --tv-hero-pad-bottom:     3.125rem;  /* 50px bottom padding */

  /* Marquee — from Figma */
  --tv-marquee-bg:          #F5F5F5;
  --tv-marquee-height:      2.5rem;    /* 40px — fixed */
  --tv-marquee-font-size:   1rem;      /* 16px desktop */
  --tv-marquee-font-weight: 400;
  --tv-marquee-color:       #000000;
  --tv-marquee-gap:         3rem;
  --tv-marquee-speed:       25s;

  /* Announcement text — from Figma */
  --tv-announce-size:    1rem;         /* 16px */
  --tv-announce-weight:  400;
  --tv-announce-color:   #000000;
  --tv-announce-lh:      1.5;          /* normalised from 13.42px raw — use relative unit */

  /* Shared button tokens */
  --tv-btn-font-size:    1rem;         /* 16px */
  --tv-btn-font-weight:  400;
  --tv-btn-gap:          0.625rem;     /* space between label and arrow */
  --tv-btn-arrow-shift:  0.375rem;     /* 6px — arrow translateX on hover */

  /* Button: yellow (CHOOSE GIFT) — from Figma */
  --tv-btn-yellow-bg:    #FFF544;
  --tv-btn-yellow-color: #000000;
  --tv-btn-yellow-pad:   0.75rem 1.5rem; /* adjusted */

  /* Button: dark (SHOP NOW / ADD TO CART) */
  --tv-btn-dark-bg:      #000000;
  --tv-btn-dark-color:   #ffffff;
  --tv-btn-dark-pad:     0.875rem 2rem; /* adjusted */

  font-family: var(--tv-font-primary);
  box-sizing: border-box;
}

/* Scoped box-sizing reset — does not affect rest of theme */
.tv-banner *,
.tv-banner *::before,
.tv-banner *::after {
  box-sizing: inherit;
}

/* ─────────────────────────────────────────────────────────────
   1. TOPBAR
   Layout: flex row, space-between
   Left: logo | Center: announcement | Right: CTA button
   ───────────────────────────────────────────────────────────── */
.tv-banner__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--tv-topbar-height);
  padding: var(--tv-topbar-pad-y) var(--tv-topbar-pad-x);
  background-color: var(--tv-topbar-bg);
}

/* Logo — left, no shrink */
.tv-banner__logo-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}

.tv-banner__logo {
  display: block;
  height: 1.1875rem; /* 19px — exact SVG viewBox height */
  width: auto;
}

/* Announcement — center column, grows to fill gap between logo and button */
.tv-banner__announcement {
  flex: 1;
  padding: 0 1.5rem;
  font-family: var(--tv-font-primary);
  font-size: var(--tv-announce-size);
  font-weight: var(--tv-announce-weight);
  line-height: var(--tv-announce-lh);
  letter-spacing: 0;
  color: var(--tv-announce-color);
  text-align: center;
  margin: 0;
  /* Prevent overflow on very small viewports */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ─────────────────────────────────────────────────────────────
   SHARED BUTTON BASE — .tv-btn
   Reused in: topbar (yellow), hero (dark), popup ADD TO CART (dark)
   ───────────────────────────────────────────────────────────── */
.tv-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--tv-btn-gap);
  font-family: var(--tv-font-primary);
  font-size: var(--tv-btn-font-size);
  font-weight: var(--tv-btn-font-weight);
  letter-spacing: 0;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  border: none;
  white-space: nowrap;
  transition: background-color 0.25s ease;
}

.tv-btn:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

/* Yellow variant */
.tv-btn--yellow {
  background-color: var(--tv-btn-yellow-bg);
  color: var(--tv-btn-yellow-color);
  padding: var(--tv-btn-yellow-pad);
}

.tv-btn--yellow:hover,
.tv-btn--yellow:focus-visible {
  background-color: #ece200;
}

/* Dark variant */
.tv-btn--dark {
  background-color: var(--tv-btn-dark-bg);
  color: var(--tv-btn-dark-color);
  padding: var(--tv-btn-dark-pad);
}

.tv-btn--dark:hover,
.tv-btn--dark:focus-visible {
  background-color: #1a1a1a;
}

/* Arrow wrapper */
.tv-btn__arrow {
  display: inline-flex;
  align-items: center;
}

/* Arrow icon — smooth slide on hover */
.tv-btn__arrow-icon {
  display: block;
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform;
}

/* Invert arrow colour for dark buttons (black SVG → white) */
.tv-btn__arrow-icon--light {
  filter: invert(1);
}

.tv-btn:hover .tv-btn__arrow-icon,
.tv-btn:focus-visible .tv-btn__arrow-icon {
  transform: translateX(var(--tv-btn-arrow-shift));
}

/* Honour user reduced-motion preference */
@media (prefers-reduced-motion: reduce) {
  .tv-btn__arrow-icon {
    transition: none;
  }
}

/* ─────────────────────────────────────────────────────────────
   2. HERO
   Full-bleed illustration with bottom-left content overlay
   ───────────────────────────────────────────────────────────── */
.tv-banner__hero {
  position: relative;
  width: 100%;
  height: calc(100vh - var(--tv-topbar-height) - var(--tv-marquee-height));
  min-height: 28rem; /* fallback if calc fails or viewport too small */
  background-color: var(--tv-hero-bg);
  display: flex;
  align-items: flex-end; /* content at bottom */
  overflow: hidden;
}

/* Background illustration — absolute positioned, full coverage */
.tv-banner__illustration {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover; /* cover to fill entire hero area on desktop */
  object-position: center;
  z-index: 0;
}

/* Content box — bottom-left overlay, desktop only has heading + description */
.tv-banner__content {
  position: absolute;
  bottom: calc(var(--tv-hero-pad-bottom) + 4rem); /* positioned above button */
  left: 0;
  z-index: 1;
  max-width: var(--tv-hero-content-max);
  padding-left: var(--tv-hero-pad-left);
  display: flex;
  flex-direction: column;
  gap: 1rem; /* gap between heading and description */
}

/* Button wrapper — desktop: separate element for flex positioning */
.tv-banner__btn-wrapper {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 1;
  padding-left: var(--tv-hero-pad-left);
  padding-bottom: var(--tv-hero-pad-bottom);
}

.tv-banner__heading {
  font-family: var(--tv-font-primary);
  font-size: var(--tv-hero-heading-size);
  font-weight: var(--tv-hero-heading-weight);
  line-height: var(--tv-hero-heading-lh);
  letter-spacing: -0.02em; /* tighter letter spacing for large heading */
  color: var(--tv-hero-heading-color);
  margin: 0;
}

.tv-banner__description {
  font-family: var(--tv-font-primary);
  font-size: var(--tv-hero-desc-size);
  font-weight: var(--tv-hero-desc-weight);
  line-height: var(--tv-hero-desc-lh);
  letter-spacing: 0;
  color: var(--tv-hero-desc-color);
  margin: 0;
}

/* ─────────────────────────────────────────────────────────────
   3. MARQUEE
   Infinite scrolling text strip at bottom
   ───────────────────────────────────────────────────────────── */
.tv-banner__marquee {
  width: 100%;
  height: var(--tv-marquee-height);
  background-color: var(--tv-marquee-bg);
  overflow: hidden;
  display: flex;
  align-items: center;
}

.tv-marquee__track {
  display: flex;
  align-items: center;
  width: max-content;
  gap: var(--tv-marquee-gap);
  will-change: transform;
}

@media (prefers-reduced-motion: no-preference) {
  .tv-marquee__track {
    animation: tv-marquee-scroll var(--tv-marquee-speed) linear infinite;
  }
}

@keyframes tv-marquee-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

.tv-marquee__text {
  font-family: var(--tv-font-primary); /* Jost, not Lustria */
  font-size: var(--tv-marquee-font-size);
  font-weight: var(--tv-marquee-font-weight);
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--tv-marquee-color);
  white-space: nowrap;
  flex-shrink: 0;
}

/* Dot separator between repeated text items */
.tv-marquee__text::after {
  content: '·';
  margin-left: var(--tv-marquee-gap);
}

/* ─────────────────────────────────────────────────────────────
   RESPONSIVE — Mobile (≤ 749px)
   ───────────────────────────────────────────────────────────── */
@media screen and (max-width: 749px) {
  /* Topbar — simplified: hamburger left, logo center, hide announcement + button */
  .tv-banner__topbar {
    justify-content: center;
    padding: var(--tv-topbar-pad-y) 1.5rem;
  }

  .tv-banner__topbar::before {
    content: '☰';
    position: absolute;
    left: 1.5rem;
    font-size: 1.5rem;
    color: #000000;
    line-height: 1;
  }

  .tv-banner__logo-link {
    order: 0;
  }

  .tv-banner__announcement,
  .tv-banner__cta {
    display: none;
  }

  /* Hero — stacked layout for mobile */
  .tv-banner__hero {
    height: auto;
    min-height: auto;
    flex-direction: column;
    align-items: stretch;
  }

  .tv-banner__illustration {
    position: relative;
    width: 100%;
    height: 12rem; /* reduced height for mobile */
    object-fit: cover; /* cover on mobile for zoomed effect like desktop and Figma */
    object-position: center;
    order: 2; /* illustration second */
    margin: 1rem 0 1.5rem; /* tighter spacing */
  }

  .tv-banner__content {
    position: relative; /* override absolute on mobile */
    bottom: auto;
    left: auto;
    max-width: 100%;
    width: 100%;
    padding: 1.5rem 1.5rem 0; /* tighter top padding */
    text-align: center;
    align-items: center;
    align-self: stretch;
    order: 1; /* heading + description first */
    gap: 0.5rem; /* tighter gap between heading and description */
  }

  .tv-banner__heading {
    font-size: 1.875rem; /* 30px */
    letter-spacing: 0;
  }

  .tv-banner__description {
    font-size: 1rem; /* 16px */
    line-height: 1.3; /* 130% */
  }

  .tv-banner__btn-wrapper {
    position: relative; /* override absolute on mobile */
    bottom: auto;
    left: auto;
    max-width: 100%;
    padding: 0 1.5rem 2rem; /* side padding + bottom */
    align-self: stretch;
    order: 3; /* button last */
    display: flex;
    justify-content: center; /* center the button */
  }

  .tv-btn.tv-banner__btn {
    width: auto; /* natural width like desktop */
    justify-content: center;
    padding: 0.75rem 1.5rem; /* reduced padding for mobile */
    font-size: 0.9375rem; /* slightly smaller on mobile */
  }

  /* Marquee — smaller font on mobile */
  .tv-marquee__text {
    font-size: 0.875rem; /* 14px */
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "TV Banner",
  "tag": "section",
  "class": "tv-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Topbar"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Leave empty to use the default Tisso Vison SVG logo"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "illustration",
      "label": "Background illustration",
      "info": "Leave empty to use the default illustration PNG"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Marquee"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "TV Banner"
    }
  ]
}
{% endschema %}
