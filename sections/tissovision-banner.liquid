{%- comment -%}
  Tisso Vision Banner Section
  ─────────────────────────────────────────────────────────────────────────────
  Custom section — do NOT use Dawn's ready-made hero/image-banner sections.
  Implements the Figma "Gift Guide" banner with:
    • Desktop: 3-col topbar + left-content / right-illustration hero + marquee
    • Mobile:  centered heading/description on top, illustration below,
               SHOP NOW button overlaid on illustration
  Fonts: Jost (all UI text), Lustria (heading only)
  Breakpoint: 750px — matches Horizon theme convention throughout
  ─────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- liquid
  assign brand_text       = section.settings.brand_text
  assign announcement     = section.settings.announcement_text
  assign choose_gift_text = section.settings.choose_gift_text
  assign choose_gift_url  = section.settings.choose_gift_url | default: '#'
  assign heading          = section.settings.heading
  assign description      = section.settings.description
  assign shop_now_text    = section.settings.shop_now_text
  assign shop_now_url     = section.settings.shop_now_url | default: '#'
  assign marquee_text     = section.settings.marquee_text
-%}

{{- 'tissovision-banner.css' | asset_url | stylesheet_tag -}}

<section
  class="tv-banner"
  aria-labelledby="tv-banner-heading-{{ section.id }}"
  id="tissovision-banner-{{ section.id }}"
>

  {%- comment -%}
    TOP BAR
    Desktop: logo left | announcement center | CHOOSE GIFT button right
    Mobile:  hidden — Dawn's own header renders above this section
  {%- endcomment -%}
  <div class="tv-banner__topbar" aria-hidden="false">
    <div class="tv-banner__topbar-inner">

      {%- comment -%} Brand logo SVG — loaded as <img> for performance (no JS needed) {%- endcomment -%}
      <div class="tv-banner__brand">
        <img
          src="{{ 'tissovision-logo.svg' | asset_url }}"
          alt="{{ brand_text | escape }}"
          class="tv-banner__brand-img"
          width="160"
          height="28"
          loading="eager"
          fetchpriority="high"
        >
      </div>

      {%- comment -%} Center announcement text {%- endcomment -%}
      {%- if announcement != blank -%}
        <p class="tv-banner__announcement">
          {{- announcement | escape -}}
        </p>
      {%- endif -%}

      {%- comment -%}
        CHOOSE GIFT button — yellow, right side
        Uses <a> because it navigates — correct semantic element
      {%- endcomment -%}
      <a
        href="{{ choose_gift_url }}"
        class="tv-banner__choose-gift"
        {% if choose_gift_url == '#' -%}
          aria-label="{{ choose_gift_text | escape }}"
        {%- endif %}
      >
        <span class="tv-banner__choose-gift-text">{{- choose_gift_text | escape -}}</span>
        <span class="tv-banner__btn-icon" aria-hidden="true">
          <img
            src="{{ 'tissovision-arrow.svg' | asset_url }}"
            alt=""
            class="tv-banner__arrow-img"
            width="20"
            height="16"
            loading="eager"
          >
        </span>
      </a>

    </div>
  </div>

  {%- comment -%}
    HERO AREA
    Desktop: left content column (heading + description + CTA) | right illustration (full-bleed)
    Mobile:  heading + description centered on top, illustration below,
             SHOP NOW button absolutely positioned over the illustration
  {%- endcomment -%}
  <div class="tv-banner__hero">

    <div class="tv-banner__content">
      <h1
        class="tv-banner__heading"
        id="tv-banner-heading-{{ section.id }}"
      >
        {{- heading | escape -}}
      </h1>

      {%- if description != blank -%}
        <p class="tv-banner__description">
          {{- description | escape -}}
        </p>
      {%- endif -%}

      {%- comment -%}
        SHOP NOW button — <a> because it navigates
        On mobile this is pulled out of flow and overlaid on the illustration
        via absolute positioning defined in the mobile CSS block
      {%- endcomment -%}
      <a
        href="{{ shop_now_url }}"
        class="tv-banner__shop-now"
        {% if shop_now_url == '#' -%}
          aria-label="{{ shop_now_text | escape }}"
        {%- endif %}
      >
        <span class="tv-banner__shop-now-text">{{- shop_now_text | escape -}}</span>
        <span class="tv-banner__btn-icon" aria-hidden="true">
          <img
            src="{{ 'tissovision-arrow.svg' | asset_url }}"
            alt=""
            class="tv-banner__arrow-img tv-banner__arrow-img--inverted"
            width="20"
            height="16"
            loading="lazy"
          >
        </span>
      </a>
    </div>

    {%- comment -%}
      Illustration — decorative, aria-hidden
      Fills the right column on desktop, bottom area on mobile
    {%- endcomment -%}
    <div class="tv-banner__illustration" aria-hidden="true">
      <img
        src="{{ 'tissovision-banner-illustration.svg' | asset_url }}"
        alt=""
        class="tv-banner__illustration-img"
        loading="eager"
        fetchpriority="high"
        width="780"
        height="560"
      >
    </div>

  </div>

  {%- comment -%}
    MARQUEE STRIP
    CSS animation (tv-marquee keyframe) scrolls the duplicated text.
    prefers-reduced-motion: animation stops, text remains visible and centered.
    Visually-hidden <p> provides accessible static text for screen readers.
  {%- endcomment -%}
  {%- if marquee_text != blank -%}
    <div class="tv-banner__marquee-wrap">
      <div class="tv-banner__marquee-track" aria-hidden="true">
        {%- comment -%}
          12 repetitions ensures seamless loop at all viewport widths.
          The CSS animates translateX(0) → translateX(-50%) on a width:max-content track,
          which works because we render exactly 2× the content (6 + 6 = 12 items,
          but the animation moves exactly half the track width).
        {%- endcomment -%}
        {%- for i in (1..12) -%}
          <span class="tv-banner__marquee-item">{{- marquee_text | escape -}}</span>
          {%- unless forloop.last -%}
            <span class="tv-banner__marquee-sep" aria-hidden="true">&nbsp;&nbsp;·&nbsp;&nbsp;</span>
          {%- endunless -%}
        {%- endfor -%}
      </div>
      <p class="visually-hidden">{{- marquee_text | escape -}}</p>
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Tisso Vision Banner",
  "tag": "div",
  "class": "tissovision-banner-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Top Bar"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand name (logo alt text)",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Center announcement text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_gift_text",
      "label": "Choose Gift button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "choose_gift_url",
      "label": "Choose Gift button link"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_now_text",
      "label": "Shop Now button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_now_url",
      "label": "Shop Now button link"
    },
    {
      "type": "header",
      "content": "Marquee Strip"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Scrolling text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Tisso Vision Banner"
    }
  ]
}
{% endschema %}
